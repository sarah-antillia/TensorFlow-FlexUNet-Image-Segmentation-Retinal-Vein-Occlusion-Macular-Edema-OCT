; train_eval_infer.config
; 2026/10/22 (C) antillia.com
; RVO-ME-OCT segmentation
[model]
model         = "TensorFlowFlexUNet"
generator     =  False

image_width    = 512
image_height   = 512
image_channels = 3
input_normalize = True
normalization  = False
num_classes    = 5
base_filters   = 16
base_kernels   = (11,11)
num_layers     = 8
dropout_rate   = 0.05
dilation       = (1,1)

; Model compilation parameters
optimizer       = "Adam"

learning_rate  = 0.00007
clipvalue      = 0.5

;loss           = "categorical_crossentropy"
;2026/09/23  Modified to use "categorical_focal_dice_loss"
loss           = "categorical_focal_dice_loss"

;metrics        = ["dice_coef_multiclass"]
;2026/09/25 Modified to use "dice_coef_hybrid".
metrics        = ["dice_coef_hybrid"]
hybrid_alpha   = 1.6
hybrid_beta    = 0.4
show_summary   = False

[dataset]
class_name    = "ImageCategorizedMaskDataset"

[train]
;epochs       = 50
epochs        = 100
batch_size    = 2

;steps_per_epoch  = 200
;validation_steps = 80

; EarlyStopping parameter
patience      = 10

;metrics       = ["dice_coef_multiclass", "val_dice_coef_multiclass"]
metrics       = ["dice_coef_hybrid", "val_dice_coef_hybrid"]

model_dir     = "./models/"
eval_dir      = "./eval/"
images_dir    = "../../../dataset/RVO-ME-OCT/train/images/"
masks_dir     = "../../../dataset/RVO-ME-OCT/train/masks/"

create_backup  = False

; learning_rate_reducer callback parameter
learning_rate_reducer = True
reducer_factor     = 0.5
reducer_patience   = 5

; Model saving option
save_weights_only  = True

[valid]
images_dir = "../../../dataset/RVO-ME-OCT/valid/images/"
masks_dir  = "../../../dataset/RVO-ME-OCT/valid/masks/"

[test] 
images_dir = "../../../dataset/RVO-ME-OCT/test/images/"
masks_dir  = "../../../dataset/RVO-ME-OCT/test/masks/"

[infer] 
images_dir    = "./mini_test/images/"
output_dir    = "./mini_test_output/"

[image]
color_order = "RGB"

[mask]
mask_datatyoe    = "categorized"
mask_file_format = ".png"
;RVO-ME-OCT rgb color map dict for 1+4 classes.
;                      #SRF: red,  #IRF: green, #ELM: blue,  #EZ: yellow
rgb_map = {(0,0,0):0, (255,0,0):1, (0,255,0):2, (0,0,255):3, (255,255,0):4}


